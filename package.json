{
  "name": "portfolio",
  "private": true,
  "version": "2.6.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite-ssg build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@lucide/vue": "^1.54.0",
    "@unhead/vue": "^2.1.17",
    "@vueuse/core": "^15.0.0",
    "motion-v": "^2.6.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "beasties": "^0.3.5",
    "happy-dom": "^20.14.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-ssg": "^28.3.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
